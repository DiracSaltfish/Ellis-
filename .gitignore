.DS_Store

# IDE/session-local state.
.idea/
tmp/
**/tmp/

# Python environments and bytecode.
**/.venv/
**/__pycache__/
**/*.py[cod]

# Local compilation and packaging outputs. Curated vendor/runtime inputs are
# kept explicitly in their project directories and are not matched here.
**/build/
**/build-*/
**/dist/
**/*.app/
**/*.dSYM/
**/*.o

# Local package archives, dependency caches, and runtime state.
**/dist-*/
**/node_modules
**/.pytest_cache/
**/.runtime/
**/*.log
**/.env
**/.env.*
!**/.env.example

