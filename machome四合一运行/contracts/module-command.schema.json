{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.machome/contracts/module-command.v1.schema.json",
  "title": "Machome Hub module command v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol",
    "type",
    "agent_instance_id",
    "config_sha256",
    "command_id",
    "module_id",
    "action",
    "expected_revision",
    "requested_at",
    "requested_by",
    "reason",
    "deadline_ms",
    "arguments"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "protocol": {"const": "module.control.v1"},
    "type": {"const": "command"},
    "agent_instance_id": {"type": "string", "minLength": 8, "maxLength": 80},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approval_token": {"type": "string", "minLength": 8, "maxLength": 80},
    "command_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,79}$"
    },
    "module_id": {"enum": ["upload", "premium", "webull", "redemption"]},
    "subservice_id": {"type": ["string", "null"], "maxLength": 128},
    "action": {"$ref": "#/$defs/action"},
    "expected_revision": {"type": "integer", "minimum": -1},
    "requested_at": {"type": "string", "format": "date-time"},
    "requested_by": {"type": "string", "minLength": 1, "maxLength": 128},
    "reason": {"type": "string", "minLength": 1, "maxLength": 512},
    "deadline_ms": {"type": "integer", "minimum": 1000, "maximum": 1800000},
    "arguments": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": true
    }
  },
  "$defs": {
    "action": {
      "enum": [
        "refresh",
        "open_legacy_ui",
        "start_service",
        "stop_service",
        "restart_service",
        "acknowledge_uncertain",
        "premium_sync",
        "premium_raw_snapshot",
        "premium_detail_subscribe",
        "premium_detail_unsubscribe",
        "premium_set_watchlist",
        "premium_set_l1_hotlist",
        "webull_get_book",
        "webull_set_mode",
        "webull_collector_start",
        "webull_collector_stop",
        "webull_restart_browser",
        "webull_show_login",
        "redemption_get_history",
        "redemption_get_pcf",
        "redemption_set_watchlist",
        "redemption_set_symbol_name",
        "redemption_monitor_start",
        "redemption_monitor_stop",
        "redemption_wind_start",
        "redemption_wind_shutdown_cleanup",
        "redemption_pcf_refresh",
        "redemption_qmt_connect",
        "redemption_qmt_disconnect",
        "redemption_qmt_sync",
        "redemption_qmt_order"
      ]
    }
  }
}
