{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://machome.local/contracts/ibkr-native-bridge-config.schema.json",
  "title": "Machome native IBKR bridge configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "socket_path", "health_file", "tws", "connection_schedule", "subscriptions"],
  "properties": {
    "schema_version": { "const": 1 },
    "socket_path": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "health_file": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "tws": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host"],
      "properties": {
        "host": {
          "type": "string",
          "description": "默认仅允许 127.0.0.1/localhost；RFC1918 IPv4 必须同时精确列入 allowed_private_hosts。"
        },
        "allowed_private_hosts": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(10\\.(?:[0-9]{1,3}\\.){2}[0-9]{1,3}|172\\.(?:1[6-9]|2[0-9]|3[01])\\.[0-9]{1,3}\\.[0-9]{1,3}|192\\.168\\.[0-9]{1,3}\\.[0-9]{1,3})$"
          }
        },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 7496 },
        "client_id": { "type": "integer", "minimum": 0, "maximum": 2000000000, "default": 41 },
        "market_data_type": { "type": "integer", "minimum": 1, "maximum": 4, "default": 1 },
        "reconnect_minimum_ms": { "type": "integer", "minimum": 250, "maximum": 60000, "default": 1000 },
        "reconnect_maximum_ms": { "type": "integer", "minimum": 1000, "maximum": 300000, "default": 30000 },
        "connect_timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 120000, "default": 10000 },
        "heartbeat_interval_ms": { "type": "integer", "minimum": 1000, "maximum": 60000, "default": 5000 },
        "heartbeat_stale_ms": { "type": "integer", "minimum": 3000, "maximum": 300000, "default": 20000 }
      }
    },
    "connection_schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "timezone", "weekdays", "start_time", "stop_time"],
      "description": "TWS socket lifecycle. The production 09:00-15:06 half-open window exactly preserves the standalone uploader's inclusive 09:00-15:05 minute policy.",
      "properties": {
        "enabled": { "type": "boolean" },
        "timezone": { "type": "string", "minLength": 1, "maxLength": 128 },
        "weekdays": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 7 }
        },
        "start_time": { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9](?::[0-5][0-9])?$" },
        "stop_time": { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9](?::[0-5][0-9])?$" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maximum_clients": { "type": "integer", "minimum": 1, "maximum": 128, "default": 32 },
        "maximum_request_bytes": { "type": "integer", "minimum": 1024, "maximum": 1048576, "default": 65536 },
        "maximum_subscriptions": { "type": "integer", "minimum": 1, "maximum": 4096, "default": 512 }
      }
    },
    "subscriptions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "symbol", "security_type", "exchange", "currency"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "con_id": { "type": "integer", "minimum": 0, "maximum": 2000000000 },
          "symbol": { "type": "string", "minLength": 1, "maxLength": 32 },
          "security_type": { "type": "string", "minLength": 1, "maxLength": 16 },
          "exchange": { "type": "string", "minLength": 1, "maxLength": 32 },
          "primary_exchange": { "type": "string", "maxLength": 32 },
          "currency": { "type": "string", "minLength": 1, "maxLength": 8 },
          "expiry": { "type": "string", "maxLength": 16 },
          "multiplier": { "type": "string", "maxLength": 16 },
          "trading_class": { "type": "string", "maxLength": 32 },
          "generic_ticks": { "type": "string", "pattern": "^[0-9,]*$", "maxLength": 128 }
        }
      }
    }
  }
}
