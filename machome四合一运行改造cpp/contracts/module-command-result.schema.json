{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.machome/contracts/module-command-result.v1.schema.json",
  "title": "Machome Hub module command result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol",
    "type",
    "instance_id",
    "command_id",
    "module_id",
    "action",
    "state",
    "message",
    "timestamp"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "protocol": {
      "const": "module.control.v1"
    },
    "type": {
      "const": "command_result"
    },
    "instance_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 80
    },
    "command_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,79}$"
    },
    "module_id": {
      "enum": [
        "upload",
        "premium",
        "webull",
        "redemption",
        "monitor_sync"
      ]
    },
    "action": {
      "$ref": "module-command.schema.json#/$defs/action"
    },
    "state": {
      "enum": [
        "accepted",
        "running",
        "succeeded",
        "failed",
        "timed_out"
      ]
    },
    "message": {
      "type": "string",
      "maxLength": 2048
    },
    "code": {
      "type": "string",
      "maxLength": 128
    },
    "expected_revision": {
      "type": "integer",
      "minimum": -1
    },
    "accepted_revision": {
      "type": "integer",
      "minimum": -1
    },
    "current_revision": {
      "type": "integer",
      "minimum": -1
    },
    "control_revision": {
      "type": "integer",
      "minimum": -1
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "requested_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "details": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
