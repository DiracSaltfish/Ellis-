{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://machome-hub.local/contracts/owner-deployment-manifest.schema.json",
  "title": "Machome Hub owner deployment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "path_base", "files"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "machome_owner_deployment_manifest"
    },
    "path_base": {
      "const": "manifest_directory"
    },
    "metadata": {
      "type": "object"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "Canonical POSIX path relative to the manifest directory; absolute paths, dot segments and backslashes are forbidden."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
