+bool CoreServer::replaceWatchlistNative(const QJsonArray &symbols,
+                                        QJsonObject *result, QString *error)
+{
+    const int maximum = config_.value(QStringLiteral("max_upstream_symbols")).toInt(1000);
+    if (symbols.isEmpty() || symbols.size() > maximum) {
+        if (error) *error = QStringLiteral("watchlist size must be 1..%1").arg(maximum);
+        return false;
+    }
+    QStringList replacement;
+    for (const QJsonValue &value : symbols) {
+        const QString normalized = normalizeSymbol(value.toString());
+        if (!isDomesticSymbol(normalized) || replacement.contains(normalized)) {
+            if (error) *error = QStringLiteral("invalid or duplicate monitored symbol: %1")
+                                    .arg(value.toString());
+            return false;
+        }
+        replacement.append(normalized);
+    }
+    QSet<QString> unique(replacement.begin(), replacement.end());
+    unique.unite(QSet<QString>(hotSymbols_.begin(), hotSymbols_.end()));
+    if (unique.size() > maximum) {
+        if (error) *error = QStringLiteral("combined pinned symbol limit exceeded");
+        return false;
+    }
+    QString legacyError;
+    if (!legacy_ || !legacy_->replacePinnedSymbols(replacement, hotSymbols_, &legacyError)) {
+        if (error) *error = legacyError.isEmpty()
+            ? QStringLiteral("L1 gateway unavailable") : legacyError;
+        return false;
+    }
+    QString persistenceError;
+    if (!persistSymbolList(QStringLiteral("watchlist"),
+                           QStringLiteral("config/watchlist.json"),
+                           replacement, &persistenceError)) {
+        legacy_->replacePinnedSymbols(fixedSymbols_, hotSymbols_);
+        if (error) *error = persistenceError;
+        return false;
+    }
+    const QSet<QString> oldSet(fixedSymbols_.begin(), fixedSymbols_.end());
+    const QSet<QString> newSet(replacement.begin(), replacement.end());
+    const QSet<QString> removed = oldSet - newSet;
+    if (oldSet != newSet) ++publicationGeneration_;
+    fixedSymbols_ = replacement;
+    for (const QString &symbol : removed) {
+        for (QuoteWorker *worker : workers_) {
+            QMetaObject::invokeMethod(worker, [worker, symbol] {
+                worker->resetSignalSymbol(symbol);
+            }, Qt::QueuedConnection);
+        }
+        signalHistory_.erase(
+            std::remove_if(signalHistory_.begin(), signalHistory_.end(),
+                           [&symbol](const QJsonObject &event) {
+                return event.value(QStringLiteral("symbol")).toString() == symbol;
+            }), signalHistory_.end());
+        const QJsonObject removedEvent{{QStringLiteral("type"), QStringLiteral("symbol_removed")},
+                                       {QStringLiteral("symbol"), symbol}};
+        Q_EMIT nativeSummaryPublished(removedEvent);
+        broadcastSummary(removedEvent);
+    }
+    sendAdapterControl(legacy_->maintainedSymbols());
+    if (result) {
+        *result = {{QStringLiteral("type"), QStringLiteral("watchlist_ack")},
+                   {QStringLiteral("accepted"), true},
+                   {QStringLiteral("count"), fixedSymbols_.size()},
+                   {QStringLiteral("symbols"), QJsonArray::fromStringList(fixedSymbols_)}};
+    }
+    return true;
+}
